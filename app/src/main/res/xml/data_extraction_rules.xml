<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules. Drawings never leave the device through cloud backup (the app is
    offline-only, and Auto Backup's 25 MB quota would cut a library off unpredictably). A
    device-to-device transfer, which the user starts and which stays local, still carries the
    sheets and the library index. Settings (DataStore) are small and go everywhere.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="sheets/" />
        <exclude domain="file" path="trash/" />
        <exclude domain="file" path="quarantine/" />
        <exclude domain="file" path="library.db" />
        <exclude domain="file" path="library.db-wal" />
        <exclude domain="file" path="library.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="trash/" />
        <exclude domain="file" path="quarantine/" />
    </device-transfer>
</data-extraction-rules>
